   "source": [
    "# 5. print only products costing more than ₹2,000.\n",
    "products = { \"Laptop\": 55000, \"Phone\": 30000, \"Headphones\": 2000, \"Mouse\": 700, \"Keyboard\": 1500}\n",
    "\n",
    "for product, price in products.items():\n",
    "    if price > 2000:\n",
    "        print(product, \": ₹\", price)       \n"
   ]
