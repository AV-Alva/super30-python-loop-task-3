    "#2. find the average temperature.\n",
    "temperatures = [32, 35, 28, 40, 38, 31, 42]\n",
    "total = 0\n",
    "for t in temperatures:\n",
    "    total = total + t\n",
    "average = total / len(temperatures)\n",
    "print(\"Average temperature:\", average)"
   ]
