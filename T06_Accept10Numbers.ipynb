    "# 6. Accept 10 numbers from the user and store them in a list using a loop.\n",
    "numbers = []\n",
    "for i in range(10):\n",
    "    num = int(input(\"Enter number :\"))\n",
    "    numbers.append(num)\n",
    "print(\"The numbers you entered are:\", numbers)"
